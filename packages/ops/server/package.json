{
  "name": "@deepseek-ai/dsh-ops-server",
  "description": "Managed-server inventory and the model-facing read-only server tools of the DeepSeek Harness ops capability",
  "version": "0.1.5-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/ops/server"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
